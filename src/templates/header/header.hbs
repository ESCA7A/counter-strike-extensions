<div class="nav-shell">

  <a class="brand" href="{{navigation.homeUrl}}">
    WOKNA<span>TAKI</span>
  </a>

  {{> menu}}

  <div class="nav-actions">

    {{#if navigation.github}}
      <a
        class="nav-github"
        href="{{navigation.github.url}}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{navigation.github.label}}
      </a>
    {{/if}}

    <label class="language-switcher">
      <span class="sr-only">
        {{localization.languageLabel}}
      </span>

      <select
        id="language-switcher"
        aria-label="{{localization.languageLabel}}"
      >
        {{#each localization.available}}
          <option
            value="{{code}}"
            data-url="{{url}}"
            {{#if active}}selected{{/if}}
          >
            {{label}}
          </option>
        {{/each}}
      </select>
    </label>

  </div>

<script
  src="{{site.basePath}}js/localeSwitcher.js"
></script>
</div>