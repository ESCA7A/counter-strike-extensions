<section class="projects-page">

  <div class="projects-shell">

    <header class="projects-header">

      <span class="projects-eyebrow">
        PROJECTS
      </span>

      <h1>
        {{#if locale.isRussian}}
          Проекты
        {{else}}
          Projects
        {{/if}}
      </h1>

      <p>
        {{#if locale.isRussian}}
          Инструменты, расширения и другие проекты
          для Counter-Strike и FACEIT.
        {{else}}
          Tools, extensions and other projects
          for Counter-Strike and FACEIT.
        {{/if}}
      </p>

    </header>

    <div class="projects-list">

      {{#each projects}}

        <article class="project-card">

          <div class="project-card-content">

            <span class="project-card-index">
              {{@index}}
            </span>

            <h2 class="project-card-title">
              {{name}}
            </h2>

            {{#if description}}
              <p class="project-card-description">
                {{description}}
              </p>
            {{/if}}

          </div>

          <a
            class="project-card-link"
            href="{{url}}"
          >
            {{#if ../locale.isRussian}}
              Открыть
            {{else}}
              Open
            {{/if}}

            <span aria-hidden="true">→</span>
          </a>

        </article>

      {{else}}

        <p class="projects-empty">
          {{#if locale.isRussian}}
            Проектов пока нет.
          {{else}}
            No projects yet.
          {{/if}}
        </p>

      {{/each}}

    </div>

  </div>

</section>