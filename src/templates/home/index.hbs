<section class="hero">
  <div class="hero-shell">

    <div class="hero-copy">

      <div class="eyebrow">
        {{home.hero.eyebrow}}
      </div>

      <h1>
        {{home.hero.title}}
      </h1>

      <p>
        {{home.hero.text}}
      </p>

    </div>

    <div class="hero-mark" aria-hidden="true">

      <div class="hero-grid"></div>

      <div class="hero-orb">
        CS<span>2</span>
      </div>

    </div>

  </div>
</section>


<section class="about">

  <div class="about-shell section-shell">

    <div class="section-kicker">
      {{home.about.eyebrow}}
    </div>

    <div class="about-grid">

      <h2>
        {{home.about.title}}
      </h2>

      <p>
        {{home.about.text}}
      </p>

    </div>

  </div>

</section>


<section class="projects" id="projects">

  <div class="projects-shell section-shell">

    <div class="section-heading">

      <div>

        <div class="section-kicker">
          {{home.projects.eyebrow}}
        </div>

        <h2>
          {{home.projects.title}}
        </h2>

      </div>

      <p>
        {{home.projects.text}}
      </p>

    </div>

    {{{banner}}}

  </div>

</section>