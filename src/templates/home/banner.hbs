<div class="project-slider">

  <div class="project-track" data-project-track>

    {{#each banners}}

      <article class="project-card">

        <div class="project-card-top">

          <span class="project-type">
            PROJECT
          </span>

        </div>

        <div class="project-card-content">

          <div>

            <h3>
              {{title}}
            </h3>

            <p>
              {{description}}
            </p>

          </div>

        </div>

        <div class="project-card-bottom">

          <a
            class="button button-secondary"
            href="{{url}}"
          >
            {{../home.common.open}}
            <span>↗</span>
          </a>

        </div>

      </article>

    {{/each}}

  </div>

  <div class="slider-controls">

    <button
      type="button"
      data-projects-prev
      aria-label="{{home.common.previous}}"
    >
      ←
    </button>

    <button
      type="button"
      data-projects-next
      aria-label="{{home.common.next}}"
    >
      →
    </button>

  </div>

</div>