{{#each banners}}

  <article class="project-card">

    <div class="project-card-top">

      <span class="project-type">
        PROJECT
      </span>

    </div>

    <div class="project-card-content">

      <h3>
        {{title}}
      </h3>

      <p>
        {{description}}
      </p>

    </div>

    <div class="project-card-bottom">

      <a
        class="button button-secondary"
        href="{{url}}"
      >
        {{../home.common.open}}
        <span>↗</span>
      </a>

    </div>

  </article>

{{/each}}