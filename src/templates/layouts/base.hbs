<!doctype html>
<html lang="{{locale.code}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {{#if meta.description}}
    <meta name="description" content="{{meta.description}}">
  {{/if}}

  <title>{{meta.title}}</title>

  <link rel="stylesheet" href="{{assets.css}}/style.css">
  <link rel="stylesheet" href="{{assets.css}}/navigation/navigation.css">
  <link rel="stylesheet" href="{{assets.css}}/hero/hero.css">
  <link rel="stylesheet" href="{{assets.css}}/about/about.css">
  <link rel="stylesheet" href="{{assets.css}}/projects/projects.css">
  <link rel="stylesheet" href="{{assets.css}}/footer/footer.css">
  <link rel="stylesheet" href="{{assets.css}}/publication/publication.css">
  <link rel="stylesheet" href="{{assets.css}}/publications/publications.css">
  {{#if styles}}
    {{#each styles}}
      <link rel="stylesheet" href="{{../assets.css}}/{{this}}">
    {{/each}}
  {{/if}}
</head>

<body>

<header class="site-header">
  {{> header}}
</header>

<main>
  {{{body}}}
</main>

<footer class="site-footer">
  {{> footer}}
</footer>

<script type="module" src="{{assets.js}}/localeSwitcher.js"></script>
</body>
</html>